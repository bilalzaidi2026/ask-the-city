# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore, so your keys never reach GitHub.

ANTHROPIC_API_KEY=sk-ant-...
NYC_APP_TOKEN=your-nyc-open-data-app-token
CENSUS_API_KEY=your-free-census-key

# Which Claude model the agent uses. Sonnet is the speed/cost sweet spot for this app.
CLAUDE_MODEL=claude-sonnet-5-5
